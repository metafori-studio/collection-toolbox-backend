#!/usr/bin/env bash
name=$1
pidfile=$2

if [ -f "$pidfile" ]; then
    PID=$(cat "$pidfile")
    if kill -0 "$PID" 2>/dev/null; then
        echo "Stopping $name (PID: $PID)..."
        kill "$PID" 2>/dev/null || true

        # Wait for it to stop
        count=0
        while kill -0 "$PID" 2>/dev/null; do
            sleep 0.5
            count=$((count + 1))
            if [ $count -ge 10 ]; then
                echo "Forcefully killing $name..."
                kill -9 "$PID" 2>/dev/null || true
                break
            fi
        done
    fi
    rm -f "$pidfile"
fi
