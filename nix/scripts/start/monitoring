#!/usr/bin/env bash
set -e
PROJ_ROOT="${PROJ_ROOT:-$(pwd)}"

# Uses env vars: PROJ_ROOT, OTEL_DATA_DIR, GRAFANA_DATA_DIR, TEMPO_DATA_DIR,
# PROMETHEUS_DATA_DIR, LOKI_DATA_DIR, PROMETHEUS_CONFIG, PROMETHEUS_PORT,
# TEMPO_CONFIG, TEMPO_PORT, LOKI_CONFIG, LOKI_PORT, OTEL_CONFIG,
# OTEL_HEALTH_CHECK_PORT, GRAFANA_DATASOURCES, GRAFANA_INI, GRAFANA_HOME,
# GRAFANA_PORT

mkdir -p "$PROJ_ROOT/$OTEL_DATA_DIR" "$PROJ_ROOT/$GRAFANA_DATA_DIR" "$PROJ_ROOT/$TEMPO_DATA_DIR" "$PROJ_ROOT/$PROMETHEUS_DATA_DIR" "$PROJ_ROOT/$LOKI_DATA_DIR"

if [ ! -f "$PROJ_ROOT/$PROMETHEUS_DATA_DIR/prometheus.pid" ] || ! kill -0 "$(cat "$PROJ_ROOT/$PROMETHEUS_DATA_DIR/prometheus.pid")" >/dev/null 2>&1; then
    prometheus \
        --config.file="$PROMETHEUS_CONFIG" \
        --storage.tsdb.path="$PROJ_ROOT/$PROMETHEUS_DATA_DIR" \
        --web.listen-address="0.0.0.0:$PROMETHEUS_PORT" \
        --web.enable-remote-write-receiver \
        >"$PROJ_ROOT/$PROMETHEUS_DATA_DIR/prometheus.log" 2>&1 &
    echo $! >"$PROJ_ROOT/$PROMETHEUS_DATA_DIR/prometheus.pid"
    "$PROJ_ROOT/nix/scripts/wait_for" "Prometheus" "http://127.0.0.1:$PROMETHEUS_PORT/-/ready"
fi

if [ ! -f "$PROJ_ROOT/$TEMPO_DATA_DIR/tempo.pid" ] || ! kill -0 "$(cat "$PROJ_ROOT/$TEMPO_DATA_DIR/tempo.pid")" >/dev/null 2>&1; then
    tempo -config.file="$TEMPO_CONFIG" >"$PROJ_ROOT/$TEMPO_DATA_DIR/tempo.log" 2>&1 &
    echo $! >"$PROJ_ROOT/$TEMPO_DATA_DIR/tempo.pid"
    "$PROJ_ROOT/nix/scripts/wait_for" "Tempo" "http://127.0.0.1:$TEMPO_PORT/ready"
fi

if [ ! -f "$PROJ_ROOT/$LOKI_DATA_DIR/loki.pid" ] || ! kill -0 "$(cat "$PROJ_ROOT/$LOKI_DATA_DIR/loki.pid")" >/dev/null 2>&1; then
    loki -config.file="$LOKI_CONFIG" >"$PROJ_ROOT/$LOKI_DATA_DIR/loki.log" 2>&1 &
    echo $! >"$PROJ_ROOT/$LOKI_DATA_DIR/loki.pid"
    "$PROJ_ROOT/nix/scripts/wait_for" "Loki" "http://127.0.0.1:$LOKI_PORT/ready"
fi

if [ ! -f "$PROJ_ROOT/$OTEL_DATA_DIR/otel.pid" ] || ! kill -0 "$(cat "$PROJ_ROOT/$OTEL_DATA_DIR/otel.pid")" >/dev/null 2>&1; then
    otelcol-contrib --config "$OTEL_CONFIG" >"$PROJ_ROOT/$OTEL_DATA_DIR/otel.log" 2>&1 &
    echo $! >"$PROJ_ROOT/$OTEL_DATA_DIR/otel.pid"
    "$PROJ_ROOT/nix/scripts/wait_for" "otel-collector" "http://127.0.0.1:$OTEL_HEALTH_CHECK_PORT/"
fi

if [ ! -f "$PROJ_ROOT/$GRAFANA_DATA_DIR/grafana.pid" ] || ! kill -0 "$(cat "$PROJ_ROOT/$GRAFANA_DATA_DIR/grafana.pid")" >/dev/null 2>&1; then
    mkdir -p "$PROJ_ROOT/$GRAFANA_DATA_DIR/provisioning/datasources"
    mkdir -p "$PROJ_ROOT/$GRAFANA_DATA_DIR/provisioning/dashboards"
    cp -f "$GRAFANA_DATASOURCES" "$PROJ_ROOT/$GRAFANA_DATA_DIR/provisioning/datasources/datasources.yaml"
    chmod +w "$PROJ_ROOT/$GRAFANA_DATA_DIR/provisioning/datasources/datasources.yaml"
    printf "apiVersion: 1
providers:
  - name: 'Default'
    orgId: 1
    folder: ''
    type: file
    disableDeletion: false
    editable: true
    updateIntervalSeconds: 10
    allowUiUpdates: true
    options:
      path: $PROJ_ROOT/nix/grafana/dashboards
" >"$PROJ_ROOT/$GRAFANA_DATA_DIR/provisioning/dashboards/all.yaml"

    grafana server \
        --config "$GRAFANA_INI" \
        --homepath "$GRAFANA_HOME" \
        cfg:default.paths.data="$PROJ_ROOT/$GRAFANA_DATA_DIR" \
        cfg:default.paths.logs="$PROJ_ROOT/$GRAFANA_DATA_DIR/logs" \
        cfg:default.paths.plugins="$PROJ_ROOT/$GRAFANA_DATA_DIR/plugins" \
        cfg:default.paths.provisioning="$PROJ_ROOT/$GRAFANA_DATA_DIR/provisioning" \
        >"$PROJ_ROOT/$GRAFANA_DATA_DIR/grafana.log" 2>&1 &
    echo $! >"$PROJ_ROOT/$GRAFANA_DATA_DIR/grafana.pid"
    "$PROJ_ROOT/nix/scripts/wait_for" "Grafana" "http://127.0.0.1:$GRAFANA_PORT/api/health"
fi

echo "  Grafana: http://localhost:$GRAFANA_PORT"
echo "  Prometheus: http://localhost:$PROMETHEUS_PORT"
echo "  Tempo: http://localhost:$TEMPO_PORT"
echo "  Loki: http://localhost:$LOKI_PORT"
