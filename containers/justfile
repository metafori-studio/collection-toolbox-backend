set shell := ["bash", "-c"]

default:
    @just --list

image_name := "ghcr.io/metafori-studio/collection-toolbox"


# Build for a specific module
build module="archeo" frontend_ref="main" vite_remote_url="":
    #!/usr/bin/env bash
    set -euo pipefail

    # Get the appropriate token environment variable
    case "{{module}}" in
        archeo) TOKEN_ENV="VITE_MAPBOX_TOKEN_ARCHEO" ;;
        etno) TOKEN_ENV="VITE_MAPBOX_TOKEN_ETNO" ;;
        *) echo "Unsupported module: {{module}}"; exit 1 ;;
    esac
    if [ -z "${!TOKEN_ENV:-}" ]; then
        echo "Error: $TOKEN_ENV is not set"
        exit 1
    fi

    podman build \
        --format docker \
        --build-arg=MODULE={{module}} \
        --build-arg=FRONTEND_REF={{frontend_ref}} \
        --build-arg=VITE_REMOTE_URL={{vite_remote_url}} \
        --build-arg=VITE_MAPBOX_TOKEN=${!TOKEN_ENV} \
        -f containers/Containerfile \
        -t {{image_name}}:{{module}}-$(echo {{frontend_ref}} | sed 's|.*/||') .

# Push a specific module image
push module="archeo" frontend_ref="main":
    podman push {{image_name}}:{{module}}-$(echo {{frontend_ref}} | sed 's|.*/||')

# Build and push a module
deploy module="archeo" frontend_ref="main" vite_remote_url="":
    @just build {{module}} {{frontend_ref}} {{vite_remote_url}}
    @just push {{module}} {{frontend_ref}}
