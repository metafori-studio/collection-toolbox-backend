# syntax=docker/dockerfile:1
FROM docker.io/node:24-alpine AS frontend-builder

ARG FRONTEND_REF=main
ARG VITE_REMOTE_URL

WORKDIR /frontend
# hadolint ignore=DL3019
RUN --mount=type=cache,id=apk,target=/etc/apk/cache \
    apk add git=~2
RUN git clone --depth 1 --branch ${FRONTEND_REF} https://github.com/metafori-studio/collection-toolbox-frontend.git .

# Create .env file from mounted secret or environment variable
RUN --mount=type=secret,id=mapbox_token,target=/run/secrets/mapbox_token,required=false \
    echo "VITE_REMOTE_URL=${VITE_REMOTE_URL}" > .env && \
    if [ -f "/run/secrets/mapbox_token" ]; then \
        echo "VITE_MAPBOX_TOKEN=$(cat /run/secrets/mapbox_token)" >> .env; \
    elif [ -n "${VITE_MAPBOX_TOKEN}" ]; then \
        echo "VITE_MAPBOX_TOKEN=${VITE_MAPBOX_TOKEN}" >> .env; \
    else \
        echo "VITE_MAPBOX_TOKEN=" >> .env; \
    fi

RUN --mount=type=cache,id=npm,target=/root/.npm \
    npm ci && \
    npm run build --workspace=apps/archeo


FROM docker.io/composer:2.9.5 AS vendor-builder

WORKDIR /app
COPY . .

WORKDIR /app/apps/archeo
RUN --mount=type=cache,id=composer-archeo,target=/root/.composer/cache \
    composer install \
    --no-interaction \
    --no-dev \
    --prefer-dist \
    --optimize-autoloader \
    --no-scripts \
    --ignore-platform-req=php \
    --ignore-platform-req=ext-intl \
    --ignore-platform-req=ext-gd \
    --ignore-platform-req=ext-exif \
    --ignore-platform-req=ext-pgsql \
    --ignore-platform-req=ext-redis \
    --ignore-platform-req=ext-imagick


FROM docker.io/dunglas/frankenphp:1.12.1-php8.5

RUN --mount=type=cache,id=apt,sharing=locked,target=/var/cache/apt \
    --mount=type=cache,id=apt-lib,sharing=locked,target=/var/lib/apt \
    apt-get update && apt-get install -y --no-install-recommends \
        git \
        ghostscript \
        imagemagick

RUN --mount=type=cache,id=php-ext,target=/tmp/docker-php-extension-installer \
    install-php-extensions \
    pdo_pgsql \
    pgsql \
    redis \
    imagick \
    pcntl \
    intl \
    zip \
    opcache \
    curl

WORKDIR /app

COPY . .
RUN rm -rf apps/archeo/bootstrap/cache/*.php

# Vendor is installed inside apps/archeo
COPY --from=vendor-builder /app/apps/archeo/vendor/ /app/apps/archeo/vendor/

WORKDIR /app/apps/archeo

RUN php artisan package:discover --ansi

COPY --from=frontend-builder /frontend/apps/archeo/dist/ /app/apps/archeo/public/

RUN php artisan octane:install --server=frankenphp

ENV OCTANE_SERVER=frankenphp

ENTRYPOINT ["php", "artisan", "octane:frankenphp"]
