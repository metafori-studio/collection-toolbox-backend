{
	"name": "metafori/monitoring",
	"description": "Prometheus application monitoring (HTTP, database, queue and runtime metrics).",
	"type": "library",
	"version": "1.0.0",
	"license": "proprietary",
	"require": {
		"spatie/laravel-prometheus": "^1.6"
	},
	"require-dev": {
		"pestphp/pest": "^4.3",
		"pestphp/pest-plugin-laravel": "^4.0"
	},
	"autoload": {
		"psr-4": {
			"Metafori\\Monitoring\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Metafori\\Monitoring\\Tests\\": "tests/"
		}
	},
	"minimum-stability": "stable",
	"extra": {
		"laravel": {
			"providers": [
				"Metafori\\Monitoring\\Providers\\MonitoringServiceProvider"
			]
		}
	}
}
