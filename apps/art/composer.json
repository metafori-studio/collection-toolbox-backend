{
    "name": "metafori/art",
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.5",
        "filament/filament": "^5.0",
        "laravel/framework": "^13.0",
        "laravel/octane": "^2.13",
        "laravel/tinker": "^3.0",
        "metafori/core": "*",
        "metafori/monitoring": "*",
        "predis/predis": "^3.5"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pail": "^1.2.2",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.24",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^4.3",
        "pestphp/pest-plugin-drift": "^4.1",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Metafori\\Art\\": "app/",
            "Metafori\\Art\\Database\\Factories\\": "database/factories/",
            "Metafori\\Art\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Metafori\\Art\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": []
    },
    "scripts": {
        "setup": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "@php artisan db:seed --force"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "bash -c 'trap \"kill 0\" EXIT INT TERM; php artisan serve & php artisan queue:listen --tries=1 --timeout=0 & php artisan pail --timeout=0 & wait'"
        ],
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../app-modules/*",
            "options": {
                "symlink": true
            }
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "$schema": "https://getcomposer.org/schema.json"
}
