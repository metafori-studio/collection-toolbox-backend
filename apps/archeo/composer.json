{
    "name": "metafori/archeomap",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "dedoc/scramble": "^0.13.14",
        "filament/filament": "^5.0",
        "filament/spatie-laravel-media-library-plugin": "^5.3",
        "laravel/framework": "^13.0",
        "laravel/octane": "^2.13",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^3.0",
        "league/flysystem": "^3.32",
        "league/flysystem-aws-s3-v3": "^3.0",
        "metafori/archeo": "*",
        "metafori/core": "*",
        "metafori/monitoring": "*",
        "phpoffice/phpspreadsheet": "^5.5",
        "proj4php/proj4php": "^2.0",
        "sentry/sentry-laravel": "^4.25",
        "spatie/laravel-medialibrary": "^11.21",
        "tpetry/laravel-postgresql-enhanced": "^3.7"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.0",
        "laravel/boost": "^2.0",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.24",
        "laravel/sail": "^1.41",
        "laravel/telescope": "^5.18",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^4.3",
        "pestphp/pest-plugin-laravel": "^4.0",
        "pestphp/pest-plugin-livewire": "^4.1"
    },
    "autoload": {
        "psr-4": {
            "Metafori\\Archeo\\": "app/",
            "Metafori\\Archeo\\Database\\Factories\\": "database/factories/",
            "Metafori\\Archeo\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Metafori\\Archeo\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "@php artisan db:seed --force",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1 --timeout=0\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php -r \"file_exists('.env') && passthru('php artisan filament:upgrade');\""
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan boost:update --ansi"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "tbachert/spi": true
        },
        "platform": {
            "php": "8.5"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../app-modules/*",
            "options": {
                "symlink": true
            }
        }
    ]
}
