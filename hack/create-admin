#!/usr/bin/env bash

# Ensure a writable HOME for PsySH inside Nix develop.
export HOME="${HOME:-/tmp}"

# Disable PsySH history file writes (fails in read‑only env)
export PSYSH_DISABLE_FILE_HISTORY=1

set -euo pipefail

if [ $# -ne 3 ]; then
    echo "Usage: $0 <email> <name> <password>"
    exit 1
fi

base64_nowrap() {
    local encoded
    encoded=$(printf '%s' "$1" | base64)
    printf '%s' "$encoded" | tr -d '\n'
}

EMAIL_B64=$(base64_nowrap "$1")
NAME_B64=$(base64_nowrap "$2")
PASS_B64=$(base64_nowrap "$3")

php artisan tinker --execute="
\$e = base64_decode('$EMAIL_B64');
\$n = base64_decode('$NAME_B64');
\$p = base64_decode('$PASS_B64');
\$u = \Metafori\Core\Models\User::firstOrCreate(['email' => \$e], ['name' => \$n, 'password' => \$p]);
\$u->assignRole(\Metafori\Core\Enums\Role::Admin);
\$status = \$u->wasRecentlyCreated ? 'Created' : 'Already existed';
\$pass = \$u->wasRecentlyCreated ? \$p : '(existing)';
echo \"\nRESULT: {\$e} | {\$pass} | Status: {\$status}\n\";"
